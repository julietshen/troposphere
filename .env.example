# The labeler's DID. Its DID document must publish an #atproto_label signing key
# (matching LABELER_SIGNING_KEY below) and an #atproto_labeler service endpoint
# pointing at this server. did:web and did:plc are both supported.
LABELER_DID=did:web:labeler.example.com

# Hex-encoded 32-byte secp256k1 private key used to sign labels.
# Generate one with: npm run keygen
LABELER_SIGNING_KEY=

# Bearer token a moderation backend presents to the label-emit API (POST /admin/labels).
ADMIN_TOKEN=

# Postgres connection string for the label and report store.
DATABASE_URL=postgres://localhost:5432/troposphere

PORT=4100

# Optional: forward inbound reports (com.atproto.moderation.createReport) to a
# moderation backend. When unset, reports are accepted and stored but not forwarded.
# REPORT_FORWARD_URL=https://your-backend.example/reports
# REPORT_FORWARD_TOKEN=

# Enrich forwarded reports by resolving the subject to its content (DID to PDS getRecord).
# On by default; set to false to skip the extra lookup.
# REPORT_ENRICH=true

# How to shape forwarded reports. 'raw' (default) posts troposphere's own JSON with a Bearer
# token. 'coop' posts Coop's POST /api/v1/report envelope with an X-API-KEY header
# (REPORT_FORWARD_TOKEN is the Coop org API key, REPORT_FORWARD_URL is Coop's /api/v1/report).
# REPORT_FORWARD_FORMAT=raw
# COOP_POST_TYPE=ATproto-post
# COOP_ACCOUNT_TYPE=ATproto-account

# Optional: enable enforcement (POST /admin/enforce). The PDS you hold admin credentials
# for (your own), used to take down or restore records and accounts. When unset,
# /admin/enforce returns 501.
# PDS_URL=https://pds.example.com
# PDS_ADMIN_PASSWORD=

# --- Ingestion worker (npm run ingest) ---
# Streams Jetstream and posts atproto records to Coop's item intake. Only COOP_ITEMS_* are
# required to run it; scope with JETSTREAM_WANTED_DIDS / JETSTREAM_COLLECTIONS so volume stays
# manageable (the full firehose is huge).
# COOP_ITEMS_URL=https://your-coop/api/v1/items/async
# COOP_ITEMS_API_KEY=
# JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# JETSTREAM_COLLECTIONS=app.bsky.feed.post,app.bsky.actor.profile
# JETSTREAM_WANTED_DIDS=
# INGEST_BATCH_SIZE=50
# INGEST_BATCH_INTERVAL_MS=1000

