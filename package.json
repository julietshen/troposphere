{
  "name": "troposphere",
  "version": "0.1.0",
  "description": "The AT Protocol arm of Coop. Ingests atproto content into Coop, signs and serves moderation labels (subscribeLabels + queryLabels), routes reports into Coop's review queue, and enforces takedowns on your PDS. Works with any atproto lexicon, PDS, or AppView.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "ingest": "node --experimental-strip-types src/ingest.ts",
    "db:init": "node --experimental-strip-types src/db/init.ts",
    "keygen": "node --experimental-strip-types src/keygen.ts",
    "smoke": "node scripts/smoke.mjs",
    "docs:build": "mdbook build docs",
    "docs:serve": "mdbook serve docs"
  },
  "dependencies": {
    "@atproto/api": "^0.20.41",
    "@atproto/common": "^0.4.11",
    "@atproto/crypto": "^0.5.4",
    "@atproto/identity": "^0.5.9",
    "@atproto/xrpc-server": "^0.12.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
